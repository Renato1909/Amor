---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionIntro from "@components/SectionIntro.astro";
import PhotoCard from "@components/PhotoCard.astro";

const base = import.meta.env.BASE_URL;
const areas = [
  { number: "01", title: "Nossa história", description: "Uma linha do tempo para os capítulos que já vivemos.", href: base + "historia/", symbol: "⌁" },
  { number: "02", title: "Cartinhas", description: "Palavras, promessas e declarações para guardar.", href: base + "cartas/", symbol: "✉" },
  { number: "03", title: "Nosso futuro", description: "Sonhos e planos que queremos construir.", href: base + "sonhos/", symbol: "✧" },
  { number: "04", title: "Nossa fé", description: "A caminhada com Deus e o serviço na Igreja.", href: base + "fe/", symbol: "✝" },
  { number: "05", title: "Nossas paixões", description: "Futebol, música e tudo o que faz parte de nós.", href: base + "paixoes/", symbol: "♫" },
  { number: "06", title: "Calendário", description: "Datas e ocasiões que merecem ser lembradas.", href: base + "calendario/", symbol: "◷" },
  { number: "07", title: "Memórias", description: "Fotografias e momentos para revisitar.", href: base + "memorias/", symbol: "▧" },
  { number: "08", title: "Gratidão", description: "Pequenos registros e motivos para agradecer.", href: base + "gratidao/", symbol: "♡" },
];
const photos = [
  { src: base + "Imagens/WhatsApp%20Image%202026-08-27%20at%2016.44.13%20(1).jpeg", alt: "Fotografia da Samira", caption: "Um registro especial" },
  { src: base + "Imagens/WhatsApp%20Image%202026-08-27%20at%2016.44.14%20(3).jpeg", alt: "Fotografia da Samira", caption: "Memórias que ficam" },
  { src: base + "Imagens/WhatsApp%20Image%202026-08-27%20at%2016.44.14%20(6).jpeg", alt: "Fotografia da Samira", caption: "Pequenos grandes momentos" },
];
---
<BaseLayout
  title="Amor — Nossa história, nossos sonhos e nossa fé"
  description="Um espaço para guardar nossa história, nossas cartas, memórias, sonhos e caminhada de fé."
>
  <section class="home-hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot"></span> UM LIVRO FEITO DE MEMÓRIAS</p>
        <h1>Algumas histórias<br />merecem ser <em>guardadas.</em></h1>
        <p class="hero-lead">
          Um lugar para registrar o que vivemos, celebrar o que somos e cuidar
          com carinho de tudo aquilo que ainda queremos construir.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href={base + "historia/"}>Conhecer nossa história <span aria-hidden="true">→</span></a>
          <a class="text-link" href={base + "cartas/"}>Ler as cartinhas <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-signature">
          <span class="signature-rule"></span>
          <span>Com amor, paciência e Deus no centro.</span>
        </div>
      </div>
      <div class="hero-portrait">
        <div class="portrait-frame">
          <img src={base + "Imagens/samira-nova.webp"} alt="Retrato da Samira" width="1080" height="1451" fetchpriority="high" />
          <span class="portrait-stamp" aria-hidden="true">♥</span>
        </div>
        <p class="portrait-caption">Um carinho em forma de lembrança</p>
      </div>
    </div>
    <div class="hero-bottom-line"><span></span><span></span><span></span></div>
  </section>

  <section class="intro-band">
    <p>AMOR <span>·</span> MEMÓRIAS <span>·</span> FÉ <span>·</span> FUTURO</p>
    <span class="intro-ornament" aria-hidden="true">✦</span>
  </section>

  <section class="areas-section section-shell">
    <SectionIntro eyebrow="UM ESPAÇO PARA CADA CAPÍTULO" title="Tudo o que faz parte da nossa história." description="Cada área tem seu próprio espaço. Aos poucos, este livro digital vai reunir lembranças, palavras, planos e experiências." align="center" />
    <div class="areas-grid">
      {areas.map((area) => (
        <a class="area-card" href={area.href}>
          <div class="area-card-top">
            <span class="area-number">{area.number}</span>
            <span class="area-symbol" aria-hidden="true">{area.symbol}</span>
          </div>
          <h3>{area.title}</h3>
          <p>{area.description}</p>
          <span class="area-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="letter-feature">
    <div class="letter-feature-inner">
      <div class="letter-decoration" aria-hidden="true">“</div>
      <div>
        <p class="eyebrow">PALAVRAS PARA GUARDAR</p>
        <h2>O amor também se demonstra<br /><em>na constância dos detalhes.</em></h2>
        <p>Uma promessa de presença, cuidado, crescimento e fé — não apenas em dias especiais, mas nas pequenas escolhas de todos os dias.</p>
        <a class="button button--light" href={base + "cartas/"}>Conhecer as cartinhas <span aria-hidden="true">→</span></a>
      </div>
      <div class="letter-seal" aria-hidden="true"><span>COM</span><strong>♥</strong><span>AMOR</span></div>
    </div>
  </section>

  <section class="memories-preview section-shell">
    <div class="memories-heading">
      <SectionIntro eyebrow="UM OLHAR SOBRE AS LEMBRANÇAS" title="Momentos que merecem ficar." description="Algumas fotografias do acervo que já faz parte deste projeto." />
      <a class="text-link" href={base + "memorias/"}>Ver memórias <span aria-hidden="true">↗</span></a>
    </div>
    <div class="photo-grid">
      {photos.map((photo) => <PhotoCard {...photo} />)}
    </div>
  </section>

  <section class="faith-band">
    <div class="faith-band-inner">
      <span class="faith-cross" aria-hidden="true">✝</span>
      <p class="eyebrow">NOSSA CAMINHADA</p>
      <h2>Que Deus esteja no centro<br /><em>de cada capítulo.</em></h2>
      <p>Que a fé nos ensine a caminhar com respeito, paciência, generosidade e dedicação — inclusive no desejo de servir juntos como acólitos.</p>
      <a class="button button--outline-light" href={base + "fe/"}>Nossa caminhada de fé <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
