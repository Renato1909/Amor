---
const base = import.meta.env.BASE_URL;
const links = [
  { label: "Nossa história", href: base + "historia/" },
  { label: "Cartinhas", href: base + "cartas/" },
  { label: "Nosso futuro", href: base + "sonhos/" },
  { label: "Nossa fé", href: base + "fe/" },
  { label: "Memórias", href: base + "memorias/" },
];
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={base} aria-label="Amor — página inicial">
      <span class="brand-mark" aria-hidden="true">A<span>♥</span></span>
      <span class="brand-copy">
        <strong>AMOR</strong>
        <small>NOSSA HISTÓRIA, NOSSOS SONHOS E NOSSA FÉ</small>
      </span>
    </a>
    <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-controls="site-navigation" aria-expanded="false" data-menu-toggle>
      <span></span><span></span>
    </button>
    <nav id="site-navigation" class="site-nav" aria-label="Navegação principal" data-site-nav>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="nav-highlight" href={base + "calendario/"}>Datas especiais <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
